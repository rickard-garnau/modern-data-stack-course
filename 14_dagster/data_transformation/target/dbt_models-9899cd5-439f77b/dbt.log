{"data": {"conn_name": "model.dbt_code.dim_occupation", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "20307251c2547b31576cd4e610eb4370bedbd048c83064907bf9530ed4f943f5", "node_finished_at": "", "node_name": "dim_occupation", "node_path": "dim\\dim_occupation.sql", "node_relation": {"alias": "dim_occupation", "database": "job_ads", "relation_name": "job_ads.warehouse.dim_occupation", "schema": "warehouse"}, "node_started_at": "2026-10-05T11:52:20.036044", "node_status": "executing", "resource_type": "model", "unique_id": "model.dbt_code.dim_occupation"}, "sql": "create or replace transient table job_ads.warehouse.dim_occupation\n    \n    \n    \n    \n    \n\n    as (with  __dbt__cte__src_occupation as (\nwith stg_job_ads as (select * from job_ads.staging.technical_field_job_ads)\n\nselect\n    occupation_group__concept_id as occupation_group_id,\n    occupation_field__concept_id as occupation_field_id,\n    occupation__label as occupation,\n    occupation_group__label as occupation_group,\n    occupation_field__label as occupation_field\nfrom stg_job_ads\n), src_occupation as (select * from __dbt__cte__src_occupation)\n\n-- we use aggregate function max() for deduplicate, but there are more alternative codes one can use for this purpose\nselect\n    md5(cast(coalesce(cast(occupation as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as occupation_id,\n    occupation,\n    max(occupation_group) as occupation_group,\n    max(occupation_field) as occupation_field\nfrom src_occupation\ngroup by occupation\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"dbt_snowflake\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_code.dim_occupation\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "99ac708b-af8d-42f8-830e-fbc0203f3e14", "level": "debug", "msg": "On model.dbt_code.dim_occupation: create or replace transient table job_ads.warehouse.dim_occupation\n    \n    \n    \n    \n    \n\n    as (with  __dbt__cte__src_occupation as (\nwith stg_job_ads as (select * from job_ads.staging.technical_field_job_ads)\n\nselect\n    occupation_group__concept_id as occupation_group_id,\n    occupation_field__concept_id as occupation_field_id,\n    occupation__label as occupation,\n    occupation_group__label as occupation_group,\n    occupation_field__label as occupation_field\nfrom stg_job_ads\n), src_occupation as (select * from __dbt__cte__src_occupation)\n\n-- we use aggregate function max() for deduplicate, but there are more alternative codes one can use for this purpose\nselect\n    md5(cast(coalesce(cast(occupation as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as occupation_id,\n    occupation,\n    max(occupation_group) as occupation_group,\n    max(occupation_field) as occupation_field\nfrom src_occupation\ngroup by occupation\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"dbt_snowflake\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_code.dim_occupation\"} */;", "name": "SQLQuery", "pid": 8440, "thread": "Thread-2 (worker)", "ts": "2026-10-05T11:52:20.051825Z"}}
